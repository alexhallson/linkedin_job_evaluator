# Gemini API Key for AI Job Evaluation
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sheets Service Account Credentials JSON path
# Default: credentials.json
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# Google Sheet Name (Target spreadsheet title in Google Drive)
SHEET_NAME=Auto Job Scrapes

# Optional explicit path to candidate CV file.
# If left commented or unset, the application automatically scans the CVs/ directory
# for any existing .pdf, .docx, or .txt file, falling back to CVs_sample/sample_cv.txt.
# CV_PATH=CVs/my_cv.pdf
