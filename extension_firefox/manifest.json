{
  "manifest_version": 3,
  "name": "LinkedIn JD to Sheets (Firefox)",
  "version": "1.0",
  "description": "Scrape LinkedIn JDs to a local Python API for Google Sheets.",
  "browser_specific_settings": {
    "gecko": {
      "id": "jd-scraper@yourdomain.local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}